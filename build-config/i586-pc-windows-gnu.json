{
  "abi-return-struct-as-int": true,
  "arch": "x86",
  "binary-format": "coff",
  "cpu": "pentium",
  "crt-objects-fallback": "mingw",
  "data-layout": "e-m:x-p:32:32-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:32-n8:16:32-a:0:32-S32",
  "dll-prefix": "",
  "dll-suffix": ".dll",
  "dll-tls-export": false,
  "dynamic-linking": true,
  "eh-frame-header": false,
  "emit-debug-gdb-scripts": false,
  "env": "gnu",
  "exe-suffix": ".exe",
  "frame-pointer": "always",
  "function-sections": false,
  "is-like-windows": true,
  "features": "-sse,-sse2",
  "late-link-args": {
    "gnu": ["-lmsvcrt", "-lmingwex", "-lmingw32", "-lgcc", "-lmsvcrt", "-lmingwex", "-luser32", "-lgdi32", "-lcomctl32", "-lkernel32"],
    "gnu-cc": ["-lmsvcrt", "-lmingwex", "-lmingw32", "-lgcc", "-lmsvcrt", "-lmingwex", "-luser32", "-lgdi32", "-lcomctl32", "-lkernel32"],
    "gnu-lld": ["-lmsvcrt", "-lmingwex", "-lmingw32", "-lgcc", "-lmsvcrt", "-lmingwex", "-luser32", "-lgdi32", "-lcomctl32", "-lkernel32"],
    "gnu-lld-cc": ["-lmsvcrt", "-lmingwex", "-lmingw32", "-lgcc", "-lmsvcrt", "-lmingwex", "-luser32", "-lgdi32", "-lcomctl32", "-lkernel32"]
  },
  "late-link-args-dynamic": {
    "gnu": ["-lgcc_s"], "gnu-cc": ["-lgcc_s"], "gnu-lld": ["-lgcc_s"], "gnu-lld-cc": ["-lgcc_s"]
  },
  "late-link-args-static": {
    "gnu": ["-lgcc_eh", "-l:libpthread.a"],
    "gnu-cc": ["-lgcc_eh", "-l:libpthread.a"],
    "gnu-lld": ["-lgcc_eh", "-l:libpthread.a"],
    "gnu-lld-cc": ["-lgcc_eh", "-l:libpthread.a"]
  },
  "linker": "i686-w64-mingw32-gcc",
  "linker-flavor": "gnu-cc",
  "llvm-target": "i586-pc-windows-gnu",
  "max-atomic-width": 64,
  "os": "windows",
  "pre-link-args": {
    "gnu": ["--dynamicbase", "--disable-auto-image-base", "-m", "i386pe", "--large-address-aware"],
    "gnu-cc": ["-fno-use-linker-plugin", "-Wl,--dynamicbase", "-Wl,--disable-auto-image-base", "-Wl,--large-address-aware"],
    "gnu-lld": ["--dynamicbase", "--disable-auto-image-base", "-m", "i386pe", "--large-address-aware"],
    "gnu-lld-cc": ["-fno-use-linker-plugin", "-Wl,--dynamicbase", "-Wl,--disable-auto-image-base", "-Wl,--large-address-aware"]
  },
  "requires-uwtable": true,
  "target-family": ["windows"],
  "target-mcount": "_mcount",
  "target-pointer-width": 32,
  "vendor": "pc"
}
