/*
 * rustid.rdef - Haiku Resource Definition for Rustid
 *
 * Can be compiled into .rsrc via Haiku Resource Compiler (rc):
 *     rc -o rustid.rsrc rustid.rdef
 * And merged into the application binary via xres:
 *     xres -o rustid_haiku rustid.rsrc
 * Or applied directly to an existing binary:
 *     addattr -f rustid.rsrc BEOS:ICON rustid_haiku
 */

resource app_signature "application/x-vnd.rustid-gui";

resource app_name_catalog_entry "c:rustid:Rustid";

resource app_version {
    major  = 2,
    minor  = 2,
    middle = 0,
    variety = B_APPV_FINAL,
    internal = 0,
    short_info = "Rustid",
    long_info = "Rustid CPU identification tool"
};

resource app_flags B_SINGLE_LAUNCH;

